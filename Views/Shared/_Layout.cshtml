<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Olympic Games</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/style.css" asp-append-version="true" />
</head>
<body>
    <header class="p-3 bg-dark text-white mb-4">
        <div class="container d-flex justify-content-between align-items-center">
            <h1 class="h3 m-0"><a asp-controller="Home" asp-action="Index" class="text-white text-decoration-none">Olympic Games</a></h1>
            <nav>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-light me-2">Home</a>
                <a asp-controller="Favorites" asp-action="Index" class="btn btn-outline-info me-2">Favorites</a>
                <a asp-controller="ToDo" asp-action="Index" class="btn btn-outline-warning">Tickets</a>
            </nav>
        </div>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>