@model OlympicGames.Models.Country

@{
    ViewData["Title"] = "Country Details";
}

<h2>@Model.Name Details</h2>

<div class="card" style="width: 18rem; margin: 20px 0;">
    <img src="https://flagcdn.com/w160/@(Model.CountryId).png" class="card-img-top" alt="@Model.Name Flag">
    <div class="card-body">
        <h5 class="card-title">@Model.Name</h5>
        <p class="card-text"><strong>Game:</strong> @Model.Game</p>
        <p class="card-text"><strong>Sport:</strong> @Model.Sport</p>
        <p class="card-text"><strong>Category:</strong> @Model.Category</p>
        
        <form asp-controller="Favorites" asp-action="Add" method="post" class="d-inline">
            <input type="hidden" asp-for="CountryId" />
            <input type="hidden" asp-for="Name" />
            <input type="hidden" asp-for="Game" />
            <input type="hidden" asp-for="Sport" />
            <input type="hidden" asp-for="Category" />
            <button type="submit" class="btn btn-primary">Add to Favorites</button>
        </form>

        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Return to Home Page</a>
    </div>
</div>